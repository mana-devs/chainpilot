{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chainpilot",
  "main": "src/cloudflare/worker.js",
  "account_id": "2a16f0b13084e583a18540303e20ea7c",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/v1/*","/a2a","/mcp","/health","/registration.json","/.well-known/*","/deliveries/*"]},
  "durable_objects": {"bindings":[{"name":"AGENT","class_name":"ChainPilotAgent"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ChainPilotAgent"]}],
  "triggers": {"crons":["*/5 * * * *"]},
  "vars": {"CHAIN_ID":"97","EXECUTION_ENABLED":"true"},
  "observability": {"enabled":true,"head_sampling_rate":0.1},
  "send_metrics": false
}
